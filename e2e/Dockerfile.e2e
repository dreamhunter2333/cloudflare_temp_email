# Keep this version in sync with @playwright/test in package.json
FROM mcr.microsoft.com/playwright:v1.63.0-noble

RUN apt-get update && apt-get install -y curl netcat-openbsd && rm -rf /var/lib/apt/lists/*

WORKDIR /app/e2e

COPY e2e/package.json e2e/package-lock.json ./
RUN npm ci

COPY e2e/ .
# Dependency-free worker modules covered by unit tests in tests/unit/
COPY worker/src/email/extract_code.ts worker/src/email/extract_mode.ts /app/worker/src/email/
COPY worker/src/email/black_list.ts /app/worker/src/email/
COPY worker/src/constants.ts /app/worker/src/
COPY worker/src/utils/filter.ts worker/src/utils/webhook_filter.ts /app/worker/src/utils/
RUN ln -s /app/e2e/node_modules /app/worker/node_modules
COPY frontend/src/components/filter.ts /app/frontend/src/components/
RUN ln -s /app/e2e/node_modules /app/frontend/node_modules

ENTRYPOINT ["/app/e2e/scripts/docker-entrypoint.sh"]
